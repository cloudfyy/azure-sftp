using './main.bicep'

param storageAccountName = 'stsftpreplace002'
param blobContainerNamePrefix = 'data'
param enableSecurityControlTag = false
param allowedIpRanges = [
	'203.0.113.10'
]
param localUsers = [
	{
		name: 'sftpuser01'
		sshPublicKey: 'ssh-rsa  sftpuser01'
	}
	{
		name: 'sftpuser02'
		sshPublicKey: 'ssh-rsa  sftpuser02'
	}
	{
		name: 'sftpuser03'
		sshPublicKey: 'ssh-rsa  sftpuser03'
	}
]

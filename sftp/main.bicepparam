using './main.bicep'

param storageAccountName = 'stsftpreplace002'
param blobContainerNamePrefix = 'data'
param enableSecurityControlTag = true
param allowedIpRanges = [
	'203.0.113.10'
]
param localUsers = [
	{
		name: 'sftpuser01'
		sshPublicKey: 'ssh-rsa  sftpuser01'
	}
	{
		name: 'sftpuser02'
		sshPublicKey: 'ssh-rsa  sftpuser02'
	}
	{
		name: 'sftpuser03'
		sshPublicKey: 'ssh-rsa  sftpuser03'
	}
	{
		name: 'sftpuser04'
		sshPublicKey: 'ssh-rsa  sftpuser04'
		accessibleUserNames: [
			'sftpuser01'
			'sftpuser02'
			'sftpuser03'
			'sftpuser04'
		]
	}
]
